{
  "name": "deep-cosmos-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run smoke && npm run build && gh-pages -d dist -b gh-pages --dotfiles",
    "typecheck": "tsc -b --noEmit",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --define:import.meta.env={} --outfile=node_modules/.cache/smoke.mjs && node node_modules/.cache/smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
